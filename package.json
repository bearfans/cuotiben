{
  "name": "myos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @myos/shared build && pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @myos/shared build && pnpm --filter @myos/api dev",
    "dev:web": "pnpm --filter @myos/shared build && pnpm --filter @myos/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @myos/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @myos/shared build && pnpm -r test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @myos/api prisma:generate",
    "db:migrate": "pnpm --filter @myos/api prisma:migrate",
    "db:deploy": "pnpm --filter @myos/api prisma:deploy",
    "db:seed": "pnpm --filter @myos/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
