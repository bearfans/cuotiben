# 应用
NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# 生产环境通过 HTTPS 访问时设为 true
COOKIE_SECURE=false
# 位于 Nginx 等反向代理之后时设为 true
TRUST_PROXY=false

# 数据库
DATABASE_URL=postgresql://myos:myos@localhost:5432/myos?schema=public

# 登录
JWT_ACCESS_SECRET=please-change-this-access-secret
JWT_ACCESS_TTL=2h
JWT_REFRESH_DAYS=30
REGISTRATION_INVITE_CODE=

# 文件存储：local 或 s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
FILE_SIGNING_SECRET=please-change-this-file-secret
FILE_URL_TTL_SECONDS=86400

# MinIO / S3（STORAGE_DRIVER=s3 时使用）
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=myos
S3_SECRET_KEY=myos-secret
S3_BUCKET=myos
S3_REGION=us-east-1

# AI：mock 或 openai（OpenAI 兼容接口）
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=1
AI_JSON_MODE=true
AI_DAILY_JOB_LIMIT=50
AI_PROMPT_VERSION=v1
AI_MAX_IMAGE_EDGE=1600

# 队列：本地开发可关闭，任务在进程内执行
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379
AI_QUEUE_CONCURRENCY=2

# PDF
PDF_ENABLED=true
PAPER_SIGNING_SECRET=please-change-this-paper-secret
PAPER_TOKEN_TTL_SECONDS=900
