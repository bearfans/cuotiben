# 复制为 .env 后按需修改。不要把真实 AI Key 提交到代码库。
POSTGRES_USER=myos
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=myos

# 访问地址：如果部署到服务器，请改成实际域名，例如 https://cuoti.example.com
# WEB_HOST=0.0.0.0 表示允许同一局域网设备访问；只想本机访问可改为 127.0.0.1
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# 如果通过 HTTPS 域名访问，请都设为 true
COOKIE_SECURE=false
TRUST_PROXY=true

# 请替换为随机长字符串，可执行 openssl rand -base64 48 生成
JWT_ACCESS_SECRET=change-this-access-secret
FILE_SIGNING_SECRET=change-this-file-secret
PAPER_SIGNING_SECRET=change-this-paper-secret
JWT_ACCESS_TTL=2h
JWT_REFRESH_DAYS=30

# 注册邀请码，留空表示允许任何人注册
REGISTRATION_INVITE_CODE=

# AI：先用 mock 跑通，配置好后再改为 openai
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_JSON_MODE=true
AI_DAILY_JOB_LIMIT=50

# 队列：保持 false 时在 API 进程内识别；true 时使用 Redis
QUEUE_ENABLED=false

PDF_ENABLED=true

# 首次启动是否写入演示账号和数据（demo / demo12345）
SEED_DEMO=false
